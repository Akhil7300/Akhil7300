APP_NAME="Backend API"
ENV=development
DATABASE_URL=sqlite:///./backend.db

# AI Credentials
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# YouTube Credentials
YOUTUBE_API_KEY=

# YouTube OAuth
# Preferred for uploads. Provide either a file path or the JSON payload.
YOUTUBE_OAUTH_CLIENT_SECRETS_FILE=
YOUTUBE_OAUTH_CLIENT_SECRETS_JSON=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8000/youtube/callback

# Fernet key for encrypting refresh tokens stored in the DB.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# Optional: secret for signing OAuth state
YOUTUBE_OAUTH_STATE_SECRET=
